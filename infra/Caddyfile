{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	@api path /api/* /health/* /docs /docs/* /openapi.json
	reverse_proxy @api api:8000
	reverse_proxy web:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
