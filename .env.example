# No environment variables are required for the zero-paid-service Docker path.
# These local defaults are shown for clarity and may be overridden.
NEXT_PUBLIC_SITE_URL=https://marketplace-label-normalizer.onrender.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
DATABASE_URL=postgresql+psycopg://labels:labels@postgres:5432/labels
VALKEY_URL=redis://valkey:6379/0
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/var/lib/label-normalizer
MAX_FILE_BYTES=26214400
MAX_BATCH_DOCUMENTS=20
MAX_PDF_PAGES=200
PROCESSING_TIMEOUT_SECONDS=120
TEMP_FILE_TTL_SECONDS=3600
WORKER_CONCURRENCY=2

# Optional hosted database (replace DATABASE_URL with a private Neon pooled URL).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Optional private temporary ImageKit storage. Blank values disable it.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional Phase 10 providers. Blank values disable them and never block boot.
AI_ENABLED=false
LOCAL_VISION_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GEMINI_MODEL=gemini-3.6-flash
VISION_MAX_IMAGE_BYTES=5242880
VISION_AUTO_APPROVE_CONFIDENCE=0.85
